{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:cdpf:schema:0.1:manifest",
  "title": "CDPF Draft 0.1 package manifest",
  "type": "object",
  "required": [
    "cdpf_version",
    "package_id",
    "created_at",
    "document"
  ],
  "properties": {
    "cdpf_version": {
      "const": "0.1"
    },
    "package_id": {
      "type": "string",
      "format": "uuid"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "generator": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "document": {
      "type": "object",
      "required": [
        "path",
        "media_type",
        "sha256",
        "size_bytes"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "media_type": {
          "const": "application/json"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": true
    },
    "attachments": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "attachment_id",
          "path",
          "media_type",
          "sha256",
          "size_bytes"
        ],
        "properties": {
          "attachment_id": {
            "type": "string",
            "format": "uuid"
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "media_type": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "size_bytes": {
            "type": "integer",
            "minimum": 0
          },
          "title": {
            "type": "string"
          },
          "role": {
            "type": "string"
          }
        },
        "additionalProperties": true
      },
      "default": []
    },
    "extensions": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
