{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:cdpf:schema:0.1:block:narrative",
  "title": "CDPF Draft 0.1 narrative block data",
  "type": "object",
  "properties": {
    "text": {
      "type": "string"
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "text"
        ],
        "properties": {
          "text": {
            "type": "string",
            "minLength": 1
          },
          "onset": {
            "type": "string"
          },
          "note": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    }
  },
  "anyOf": [
    {
      "required": [
        "text"
      ]
    },
    {
      "required": [
        "items"
      ]
    }
  ],
  "additionalProperties": true
}
