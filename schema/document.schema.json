{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:cdpf:schema:0.1:document",
  "title": "CDPF Draft 0.1 clinical document",
  "type": "object",
  "required": [
    "cdpf_version",
    "document_id",
    "document_type",
    "status",
    "created_at",
    "subject",
    "authors",
    "blocks"
  ],
  "properties": {
    "cdpf_version": {
      "const": "0.1"
    },
    "document_id": {
      "type": "string",
      "format": "uuid"
    },
    "document_type": {
      "$ref": "urn:cdpf:schema:0.1:common#/$defs/coding"
    },
    "status": {
      "enum": [
        "draft",
        "final",
        "amended",
        "cancelled"
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "modified_at": {
      "type": "string",
      "format": "date-time"
    },
    "subject": {
      "type": "object",
      "required": [
        "subject_id"
      ],
      "properties": {
        "subject_id": {
          "type": "string",
          "minLength": 1
        },
        "display_name": {
          "type": "string"
        },
        "identifiers": {
          "type": "array",
          "items": {
            "$ref": "urn:cdpf:schema:0.1:common#/$defs/identifier"
          }
        },
        "sex": {
          "type": "string"
        },
        "birth_date": {
          "type": "string",
          "format": "date"
        },
        "extensions": {
          "type": "object",
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "encounter": {
      "type": "object",
      "properties": {
        "encounter_id": {
          "type": "string"
        },
        "started_at": {
          "type": "string",
          "format": "date-time"
        },
        "ended_at": {
          "type": "string",
          "format": "date-time"
        },
        "location": {
          "type": "string"
        },
        "extensions": {
          "type": "object",
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "authors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "name"
        ],
        "properties": {
          "author_id": {
            "type": "string"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "qualifications": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "organization": {
            "type": "string"
          },
          "identifiers": {
            "type": "array",
            "items": {
              "$ref": "urn:cdpf:schema:0.1:common#/$defs/identifier"
            }
          },
          "extensions": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "additionalProperties": true
      }
    },
    "blocks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "block_id",
          "block_type",
          "data"
        ],
        "properties": {
          "block_id": {
            "type": "string",
            "format": "uuid"
          },
          "block_type": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string"
          },
          "data": {},
          "extensions": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "additionalProperties": true
      }
    },
    "presentation": {
      "type": "object",
      "additionalProperties": true
    },
    "extensions": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
